<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>e0509_camera_lab</name>
  <version>0.1.0</version>
  <description>Eye-to-hand camera lab for Doosan E0509 (virtual RealSense, calibration, vision pick and place)</description>
  <maintainer email="airoboticshj@gmail.com">airoboticshj</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>e0509_gripper_demo</exec_depend>
  <exec_depend>dsr_msgs2</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
